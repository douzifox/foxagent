{
  "name": "foxagent",
  "description": "自己的 coding agent —— 终端 CLI + MCP 服务器，读代码、改代码、跑命令",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit",
    "cli": "bun src/cli.ts",
    "cli:compile": "bun build --compile src/cli.ts --outfile foxagent",
    "cli:compile:win": "bun build --compile --target=bun-windows-x64 src/cli.ts --outfile foxagent.exe"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "diff": "^9.0.0"
  }
}
