{
  "name": "foxagent",
  "description": "Persistent execution layer for your main coding agent: an MCP server with resumable sessions, plus a standalone terminal CLI",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit",
    "cli": "bun src/cli.ts",
    "cli:compile": "bun build --compile src/cli.ts --outfile foxagent",
    "cli:compile:win": "bun build --compile --target=bun-windows-x64 src/cli.ts --outfile foxagent.exe"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "diff": "^9.0.0"
  }
}
